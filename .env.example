# Copy this file to .env for local development.
# Never commit .env or replace these placeholders with real credentials here.

NODE_ENV=development
PORT=5000

# Optional persistent MongoDB connection used in production.
MONGODB_URI=

# Secret used to sign and verify authentication tokens.
JWT_SECRET=

# GITHUB_TOKEN is used by Git tooling only, not by the application.
# SESSION_SECRET is reserved for future session middleware.
# Keep both values in your local .env only if they are needed.